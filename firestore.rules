rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 3. Primitive definitions & global helpers
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Validation helper for UserProgress (the abstract schema)
    function isValidUserProgress(data) {
      return data.uid is string &&
        data.uid.size() <= 128 &&
        (!('email' in data) || (data.email is string && data.email.size() <= 256)) &&
        (!('dailyStreak' in data) || (data.dailyStreak is int && data.dailyStreak >= 0 && data.dailyStreak <= 10000)) &&
        (!('lastActiveDate' in data) || (data.lastActiveDate is string && data.lastActiveDate.size() <= 10)) &&
        (!('completedInterviewSessionsCount' in data) || (data.completedInterviewSessionsCount is int && data.completedInterviewSessionsCount >= 0)) &&
        (!('lastDailyBlitzDate' in data) || (data.lastDailyBlitzDate is string && data.lastDailyBlitzDate.size() <= 10)) &&
        (!('masteredQuestionIds' in data) || (data.masteredQuestionIds is list && data.masteredQuestionIds.size() <= 5000)) &&
        (!('bookmarkedQuestionIds' in data) || (data.bookmarkedQuestionIds is list && data.bookmarkedQuestionIds.size() <= 5000)) &&
        (!('solvedIncidentIds' in data) || (data.solvedIncidentIds is list && data.solvedIncidentIds.size() <= 1000)) &&
        (!('seenAchievementIds' in data) || (data.seenAchievementIds is list && data.seenAchievementIds.size() <= 1000)) &&
        (!('flashcardBoxes' in data) || (data.flashcardBoxes is map)) &&
        (!('flashcardLastReview' in data) || (data.flashcardLastReview is map)) &&
        (!('customNotes' in data) || (data.customNotes is map)) &&
        (!('dailyBlitzHistory' in data) || (data.dailyBlitzHistory is map)) &&
        (!('quizResults' in data) || (data.quizResults is list && data.quizResults.size() <= 1000)) &&
        (!('savedLegend' in data) || (data.savedLegend is map));
    }

    // 2. Collection Rules
    match /users/{userId} {
      // Owner-only reads. No list permission exists (preventing query scraping)
      allow get: if isOwner(userId) && isValidId(userId);

      // Create: user is verified, ID matches, valid schema & server timestamp
      allow create: if isOwner(userId) && 
        isValidId(userId) &&
        isValidUserProgress(incoming()) &&
        incoming().uid == userId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      // Update: owner, valid schema, immutable fields preserved, server timestamp verified, only specific fields modified
      allow update: if isOwner(userId) &&
        isValidId(userId) &&
        isValidUserProgress(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'email', 'masteredQuestionIds', 'bookmarkedQuestionIds', 'flashcardBoxes',
          'flashcardLastReview', 'quizResults', 'dailyStreak', 'lastActiveDate',
          'customNotes', 'savedLegend', 'solvedIncidentIds', 'completedInterviewSessionsCount',
          'lastDailyBlitzDate', 'dailyBlitzHistory', 'seenAchievementIds', 'updatedAt'
        ]);

      // Delete: only owner can delete their account
      allow delete: if isOwner(userId) && isValidId(userId);
    }
  }
}
